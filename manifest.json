{
  "manifest_version": 3,
  "name": "idp helper",
  "version": "1.0.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "idp helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://moodle.bfh.ch/*",
    "https://login.eduid.ch/*",
    "https://ilias.unibe.ch/*",
    "https://wayf.switch.ch/",
    "https://moodle.fhgr.ch/"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
